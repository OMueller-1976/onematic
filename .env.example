# ONEmatic – Required Environment Variables
# Copy to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Note: In .env.local this key is misspelled as STIPE_WEBHOOK_SECRET (missing R).
# The correct name used in code (app/api/stripe/webhook/route.ts) is:
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ── AI APIs ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── App ───────────────────────────────────────────────────────────────────────
# Used for absolute redirect URLs in Stripe checkout and agentic trigger callbacks.
# Set to your production domain in Vercel env vars (e.g. https://app.onematic.de).
# Falls back to http://localhost:3000 if not set.
NEXT_PUBLIC_BASE_URL=https://app.onematic.de

# ── Demo Account (server-side only — never expose in client code) ─────────────
DEMO_ACCOUNT_EMAIL=your_demo_account_email
DEMO_ACCOUNT_PASSWORD=your_demo_account_password
